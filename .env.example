# Assistant La P'tite Barque (Claude Haiku) — SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC.
# Copier ce fichier en .env.local et renseigner la clé.
ANTHROPIC_API_KEY=

# Google Maps Embed API — itinéraires intégrés de la section « Alentours ».
# Exposée au client (préfixe NEXT_PUBLIC). Sans elle : repli carte simple.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# URL canonique du site (utilisée pour le sitemap / les métadonnées Open Graph).
# En local on peut laisser http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://laptitebarque.com

# Sanity — back-office (Studio embarqué sur /studio).
# L'identifiant de projet et le dataset ne sont pas des secrets : ils sont
# exposés au client, comme dans tout Studio embarqué.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token d'ÉCRITURE Sanity — SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC, jamais
# commité. Utilisé seulement par scripts/migrate-to-sanity.ts.
SANITY_MIGRATION_TOKEN=
